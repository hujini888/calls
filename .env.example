# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Optional: only these Telegram chat IDs may use the bot.
# Leave empty for unrestricted access.
TELEGRAM_ALLOWED_CHAT_IDS=

DATABASE_PATH=data/zvonki.sqlite3
POLL_INTERVAL_SECONDS=2
DEFAULT_MIN_LIQUIDITY_USD=5000
DEFAULT_COOLDOWN_SECONDS=600
LOG_LEVEL=INFO

